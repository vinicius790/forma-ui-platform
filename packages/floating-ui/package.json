{
  "name": "@forma-ui/floating-ui",
  "version": "100.0.0",
  "description": "Optional Floating UI DOM adapter for anchored overlays and popovers",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "peerDependencies": {
    "@floating-ui/dom": ">=1.6.0",
    "@forma-ui/core": "^100.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.2",
    "rollup": "^4.40.0",
    "typescript": "^5.8.3",
    "tslib": "^2.8.1",
    "@forma-ui/core": "workspace:*",
    "@floating-ui/dom": "^1.7.4"
  },
  "scripts": {
    "build": "rollup -c && tsc -p tsconfig.json --emitDeclarationOnly && node ../../scripts/finalize-declarations.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
