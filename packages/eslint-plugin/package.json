{
  "name": "@forma-ui/eslint-plugin",
  "version": "100.0.0",
  "description": "ESLint flat-config rules for accessible Forma UI integrations",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "node --check src/index.mjs && node scripts/build.mjs",
    "typecheck": "node --check src/index.mjs",
    "test": "node --test src/index.test.mjs"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0 <10.0.0"
  },
  "devDependencies": {
    "eslint": "^9.25.1"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
