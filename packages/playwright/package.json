{
  "name": "@forma-ui/playwright",
  "version": "100.0.0",
  "description": "Browser-level testing utilities and Playwright configuration for Forma UI",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "playwright.config.ts",
    "e2e"
  ],
  "scripts": {
    "build": "rollup -c && tsc -p tsconfig.json --emitDeclarationOnly && node ../../scripts/finalize-declarations.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "playwright test -c playwright.config.ts"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.50.0",
    "@forma-ui/core": "^100.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.2",
    "rollup": "^4.40.0",
    "typescript": "^5.8.3",
    "tslib": "^2.8.1",
    "@forma-ui/core": "workspace:*",
    "@playwright/test": "^1.51.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
