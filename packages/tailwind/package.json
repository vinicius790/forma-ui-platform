{
  "name": "@forma-ui/tailwind",
  "version": "100.0.0",
  "description": "Optional Tailwind CSS v4 @theme layer and serializable JavaScript token mapping for Tailwind v3+.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./styles.css"
  ],
  "files": [
    "dist",
    "styles.css",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c && tsc -p tsconfig.json --emitDeclarationOnly && node scripts/build.mjs && node ../../scripts/finalize-declarations.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "tailwindcss": ">=3.4.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.2",
    "rollup": "^4.40.0",
    "typescript": "^5.8.3",
    "tslib": "^2.8.1"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./styles.css"
  },
  "dependencies": {
    "@forma-ui/tokens": "workspace:*"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
