{
  "name": "@forma-ui/a11y-testing",
  "version": "100.0.0",
  "description": "axe-core helpers and ARIA contract assertions for Forma UI tests",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "peerDependencies": {
    "axe-core": ">=4.8.0"
  },
  "scripts": {
    "build": "rollup -c && tsc -p tsconfig.json --emitDeclarationOnly && node ../../scripts/finalize-declarations.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.2",
    "rollup": "^4.40.0",
    "typescript": "^5.8.3",
    "tslib": "^2.8.1",
    "vitest": "^3.1.1",
    "axe-core": "^4.14.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.16.0"
  }
}
