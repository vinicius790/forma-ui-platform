{
  "name": "@forma-ui/preact",
  "version": "100.0.0",
  "description": "Preact hooks and reactive bindings for Forma UI headless controllers",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c && tsc -p tsconfig.json --emitDeclarationOnly && node ../../scripts/finalize-declarations.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src"
  },
  "peerDependencies": {
    "preact": ">=10.19.0",
    "@forma-ui/core": "^100.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.2",
    "rollup": "^4.68.8",
    "typescript": "^5.8.3",
    "tslib": "^2.8.1",
    "vitest": "^3.1.1",
    "preact": "^10.27.2",
    "@forma-ui/core": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@forma-ui/core": {
      "optional": false
    }
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
