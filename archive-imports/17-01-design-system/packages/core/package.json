{
  "name": "@forma-ui/core",
  "version": "1.0.0",
  "description": "Primitivas headless agn\u00f3sticas de estilo e framework com foco, teclado, ARIA, portais, i18n e RTL.",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./primitives": {
      "types": "./dist/primitives/index.d.ts",
      "import": "./dist/primitives/index.mjs",
      "require": "./dist/primitives/index.cjs"
    },
    "./button": {
      "types": "./dist/components/button.d.ts",
      "import": "./dist/components/button.mjs",
      "require": "./dist/components/button.cjs"
    },
    "./dialog": {
      "types": "./dist/components/dialog.d.ts",
      "import": "./dist/components/dialog.mjs",
      "require": "./dist/components/dialog.cjs"
    },
    "./menu": {
      "types": "./dist/components/menu.d.ts",
      "import": "./dist/components/menu.mjs",
      "require": "./dist/components/menu.cjs"
    },
    "./tabs": {
      "types": "./dist/components/tabs.d.ts",
      "import": "./dist/components/tabs.mjs",
      "require": "./dist/components/tabs.cjs"
    },
    "./tooltip": {
      "types": "./dist/components/tooltip.d.ts",
      "import": "./dist/components/tooltip.mjs",
      "require": "./dist/components/tooltip.cjs"
    },
    "./select": {
      "types": "./dist/components/select.d.ts",
      "import": "./dist/components/select.mjs",
      "require": "./dist/components/select.cjs"
    },
    "./toast": {
      "types": "./dist/components/toast.d.ts",
      "import": "./dist/components/toast.mjs",
      "require": "./dist/components/toast.cjs"
    },
    "./accordion": {
      "types": "./dist/components/accordion.d.ts",
      "import": "./dist/components/accordion.mjs",
      "require": "./dist/components/accordion.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c rollup.config.mjs",
    "typecheck": "tsc --noEmit"
  }
}
