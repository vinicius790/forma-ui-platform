    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "axe-core": "^4.10.2"
  },
  "scripts": {
    "build": "rollup -c rollup.config.mjs",
    "typecheck": "tsc --noEmit"
  }
}
