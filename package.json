{
  "name": "forma-ui",
  "version": "100.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "api:docs": "typedoc --options typedoc.json",
    "build": "pnpm -r --if-present build",
    "bundle:report": "node scripts/bundle-report.mjs",
    "changeset": "changeset",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:packages": "node scripts/check-packages.mjs",
    "check:publish": "node scripts/check-publish.mjs",
    "check:security": "pnpm audit --prod --audit-level moderate",
    "check:structure": "node scripts/check-structure.mjs",
    "check:unused": "knip",
    "clean": "node scripts/clean.mjs",
    "docs:build": "pnpm --filter @forma-ui/docs build",
    "docs:dev": "pnpm --filter @forma-ui/docs dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "pack:dry": "node scripts/pack-dry-run.mjs",
    "prepack": "pnpm build && pnpm verify:exports",
    "release": "pnpm build && pnpm verify:exports && changeset publish",
    "release:check": "node scripts/release-check.mjs",
    "smoke": "node scripts/smoke-check.mjs",
    "storybook": "pnpm --filter @forma-ui/storybook storybook",
    "storybook:build": "pnpm --filter @forma-ui/storybook build-storybook",
    "test": "vitest run && pnpm test:node",
    "test:a11y": "vitest run --project a11y",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test -c packages/playwright/playwright.config.ts",
    "test:property": "vitest run packages/core/src/__tests__/property-controls.test.ts packages/dates/src/__tests__/dates.test.ts packages/virtualization/src/__tests__/virtualizer.test.ts",
    "typecheck": "pnpm -r --if-present typecheck",
    "typecheck:core": "tsc -p packages/core/tsconfig.json --noEmit",
    "verify:exports": "node scripts/verify-exports.mjs",
    "verify:runtime": "node --experimental-transform-types scripts/verify-core-and-domains.mjs && node --experimental-transform-types scripts/verify-enterprise-and-platform.mjs && node --experimental-transform-types scripts/verify-workbench-ai-and-crdt.mjs",
    "test:node": "node --test packages/eslint-plugin/src/index.test.mjs packages/cli/src/index.test.mjs",
    "validate:source": "node scripts/check-structure.mjs && node scripts/check-packages.mjs && node scripts/check-workspace-graph.mjs && node scripts/check-architecture.mjs && node scripts/check-docs.mjs && node scripts/check-source-hygiene.mjs && node scripts/verify-benchmark-fixtures.mjs && node scripts/check-archive-manifest.mjs && node scripts/check-source-merge.mjs",
    "generate:architecture": "node scripts/generate-architecture-map.mjs",
    "generate:inventory": "node scripts/generate-inventory.mjs",
    "check:hygiene": "node scripts/check-source-hygiene.mjs",
    "check:legal-release": "node scripts/check-legal-release.mjs",
    "check:workspace-graph": "node scripts/check-workspace-graph.mjs",
    "generate:test-inventory": "node scripts/generate-test-inventory.mjs",
    "generate:archive-manifest": "node scripts/generate-archive-manifest.mjs",
    "generate:source-merge": "node scripts/generate-source-merge-manifest.mjs",
    "check:archive-manifest": "node scripts/check-archive-manifest.mjs",
    "archive:source": "python scripts/create-source-archive.py ../forma-ui-merged.zip",
    "fixtures:generate": "node scripts/generate-benchmark-fixtures.mjs",
    "fixtures:verify": "node scripts/verify-benchmark-fixtures.mjs",
    "bench:fixtures": "node scripts/benchmark-fixtures.mjs",
    "check:source-merge": "node scripts/check-source-merge.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.27.12",
    "@eslint/js": "^9.25.1",
    "@floating-ui/dom": "^1.7.4",
    "@playwright/test": "^1.51.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.13.14",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.74.0",
    "@vitest/coverage-v8": "^3.1.1",
    "axe-core": "^4.14.0",
    "eslint": "^9.25.1",
    "fast-check": "^3.23.2",
    "jsdom": "^26.0.0",
    "knip": "^5.50.5",
    "prettier": "^3.5.3",
    "publint": "^0.3.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rollup": "^4.40.0",
    "svelte": "^5.25.5",
    "typedoc": "^0.28.3",
    "typescript": "^5.8.3",
    "vite": "^6.2.5",
    "vitest": "^3.1.1",
    "vue": "^3.5.13"
  }
}
